                  "  pm.response.to.have.status(403);",
                  "  pm.expect(pm.response.json().details.reason).to.eql('ALREADY_ENROLLED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeId\": \"{{challengeId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{adminApi}}/auth/totp/enroll"
          }
        }
      ]
    },
