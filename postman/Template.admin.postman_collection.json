          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{adminApi}}/auth/login",
            "description": "A challenge is single-use; the wrong code above spent the last one."
          }
        },
        {
          "name": "POST /auth/mfa — the real code",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// RFC 6238 in the Postman sandbox, so the collection can log itself in.",
                  "// Same algorithm as backend/src/infrastructure/admin/totp.ts — base32 key,",
                  "// HMAC-SHA1 over a 64-bit big-endian step counter, dynamic truncation.",
                  "const secret = pm.collectionVariables.get('adminTotpSecret') || '';",
                  "if (!secret) { throw new Error('run \"POST /auth/totp/enroll\" first — it sets adminTotpSecret'); }",
                  "",
                  "const ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';",
                  "let bits = '';",
                  "for (const ch of secret.replace(/=+$/, '').toUpperCase()) {",
                  "  const v = ALPHABET.indexOf(ch);",
                  "  if (v >= 0) bits += v.toString(2).padStart(5, '0');",
                  "}",
                  "let hex = '';",
                  "for (let i = 0; i + 8 <= bits.length; i += 8) {",
                  "  hex += parseInt(bits.substr(i, 8), 2).toString(16).padStart(2, '0');",
                  "}",
                  "",
                  "const step = Math.floor(Date.now() / 1000 / 30);",
                  "const counter = step.toString(16).padStart(16, '0');",
                  "const mac = CryptoJS.HmacSHA1(",
                  "  CryptoJS.enc.Hex.parse(counter),",
                  "  CryptoJS.enc.Hex.parse(hex),",
                  ").toString(CryptoJS.enc.Hex);",
                  "",
                  "// Dynamic truncation — RFC 4226 §5.3. The low nibble of the last byte picks",
                  "// the offset; the top bit of the selected word is masked off.",
                  "const offset = parseInt(mac.substr(mac.length - 1, 1), 16) * 2;",
                  "const binary = parseInt(mac.substr(offset, 8), 16) & 0x7fffffff;",
                  "pm.collectionVariables.set('adminTotpCode', String(binary % 1000000).padStart(6, '0'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('★ signed in, with both admin cookies', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.role).to.be.oneOf(['ADMIN', 'SUPPORT']);",
                  "  pm.collectionVariables.set('adminUserId', body.id);",
                  "});",
                  "pm.test('★ the cookies are Path=/admin and SameSite=Strict (12 §3.2)', () => {",
                  "  const set = pm.response.headers.filter(h => h.key.toLowerCase() === 'set-cookie').map(h => h.value);",
                  "  const access = set.find(v => v.startsWith('admin_access='));",
                  "  const refresh = set.find(v => v.startsWith('admin_refresh='));",
                  "  pm.expect(access, 'admin_access present').to.be.a('string');",
                  "  pm.expect(refresh, 'admin_refresh present').to.be.a('string');",
                  "  for (const cookie of [access, refresh]) {",
                  "    pm.expect(cookie).to.include('Path=/admin');",
                  "    pm.expect(cookie).to.include('HttpOnly');",
                  "    pm.expect(cookie).to.include('SameSite=Strict');",
                  "  }",
                  "});",
                  "pm.test('stepUpValidUntil is in the future — the ⚡ window is open', () => {",
                  "  pm.expect(new Date(pm.response.json().stepUpValidUntil).getTime()).to.be.above(Date.now());",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeId\": \"{{challengeId}}\",\n  \"code\": \"{{adminTotpCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{adminApi}}/auth/mfa",
            "description": "The pre-request script computes the code from the secret the enroll step captured — the same RFC 6238 algorithm the server runs."
          }
        },
        {
          "name": "POST /auth/login — for the replay attempt",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.collectionVariables.set('challengeId', pm.response.json().challengeId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{adminApi}}/auth/login"
          }
        },
        {
          "name": "★★ POST /auth/mfa — the SAME code again",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('★★ refused, though the code is still on the phone’s screen', () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().details.reason).to.eql('INVALID_MFA_CODE');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeId\": \"{{challengeId}}\",\n  \"code\": \"{{adminTotpCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{adminApi}}/auth/mfa",
            "description": "★★ No pre-request script here: it deliberately reuses `adminTotpCode` from the successful login above, unchanged and still inside its 30-second window.\n\nThis is `AdminCredential.lastTotpStep`. Without it a code stays valid however often it is presented — so shoulder-surfing one, or pulling one out of a proxy log, buys a login. It is the entire value of the second factor."
          }
        }
      ]
    },
