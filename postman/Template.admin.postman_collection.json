                "type": "text/javascript",
                "exec": [
                  "pm.test('the URI, the secret and ten recovery codes — once', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.otpauthUri).to.include('otpauth://totp/');",
                  "  pm.expect(body.recoveryCodes).to.have.lengthOf(10);",
                  "  pm.collectionVariables.set('adminTotpSecret', body.secret);",
                  "  pm.collectionVariables.set('challengeId', body.challengeId);",
                  "});",
                  "pm.test('★ the recovery codes avoid I/O/0/1 — they get read aloud', () => {",
                  "  pm.expect(pm.response.json().recoveryCodes.join('')).to.not.match(/[IO01]/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeId\": \"{{challengeId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{adminApi}}/auth/totp/enroll",
            "description": "★ The ONLY route an unenrolled admin can reach. Everything in the response is unrecoverable afterwards: the secret is stored only as AES-256-GCM ciphertext and the codes only as sha256 hashes. There is no \"show me again\", because a route that could show them to you could show them to whoever has your cookie."
          }
        },
