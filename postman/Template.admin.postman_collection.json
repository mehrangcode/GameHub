      "name": "04 ★★ The one write, and the guards in front of it",
      "item": [
        {
          "name": "POST /users/:id/disable — no reason → REASON_REQUIRED",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('★ 400 REASON_REQUIRED, and nothing was written', () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().code).to.eql('REASON_REQUIRED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{adminApi}}/users/{{targetUserId}}/disable",
            "description": "`reason` is a column and an error, not a UI placeholder. Six months from now \"who disabled this account\" is answerable from the row, and \"why\" only if somebody was made to type it."
          }
        },
        {
          "name": "POST /users/:id/disable — self → SELF_TARGET_FORBIDDEN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('★ 409 — an admin may not aim this at themselves', () => {",
                  "  pm.response.to.have.status(409);",
                  "  pm.expect(pm.response.json().code).to.eql('SELF_TARGET_FORBIDDEN');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
