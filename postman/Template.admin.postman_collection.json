                  "  pm.collectionVariables.set('challengeId', pm.response.json().challengeId);",
                  "});",
                  "pm.test('no longer enrollmentRequired', () => {",
                  "  pm.expect(pm.response.json().enrollmentRequired).to.be.undefined;",
                  "});"
                ]
