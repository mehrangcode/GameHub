# Copy to .env for local development.  Every variable here is Zod-validated at
# startup by src/config/env.ts — a missing or malformed value exits the process.

NODE_ENV=development
PORT=3000
ADMIN_PORT=3100

# 02-technical-prd.md §6.1 — sqlite in dev, postgresql in prod.
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"

# Optional in dev. Unset → in-memory socket adapter + in-process rate limiter.
# REDIS_URL=redis://localhost:6379

CORS_ORIGIN=http://localhost:5173

# Minimum 32 characters each. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-0123456789
GUEST_TOKEN_SECRET=dev-only-guest-secret-change-me-0123456789

# 07-security-and-anticheat.md §5.3 — 10 min access, 30 day refresh, 12 h guest.
# The access token is stateless and cannot be revoked, so its TTL is the window
# in which a ban or a logout has not taken effect yet. Keep it short.
ACCESS_TOKEN_TTL_SEC=600
REFRESH_TOKEN_TTL_SEC=2592000
GUEST_SESSION_TTL_SEC=43200

# argon2id cost — OWASP's baseline (07 §5.3). Raising these is the response to
# faster attacker hardware; existing hashes upgrade on the owner's next login.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Global per-IP sliding window, then the login-specific throttle.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SEC=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SEC=900

LOG_LEVEL=debug

SEED_ADMIN_EMAIL=admin@local.dev
SEED_ADMIN_PASSWORD=change-me-before-prod
