# Copy to .env for local development.  Every variable here is Zod-validated at
# startup by src/config/env.ts — a missing or malformed value exits the process.

NODE_ENV=development
PORT=3000
ADMIN_PORT=3100

# 02-technical-prd.md §6.1 — sqlite in dev, postgresql in prod.
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"

# Optional in dev. Unset → in-memory socket adapter + in-process rate limiter.
# REDIS_URL=redis://localhost:6379

CORS_ORIGIN=http://localhost:5173

# Minimum 32 characters each. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-0123456789
GUEST_TOKEN_SECRET=dev-only-guest-secret-change-me-0123456789

ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000
GUEST_SESSION_TTL_SEC=43200

LOG_LEVEL=debug

SEED_ADMIN_EMAIL=admin@local.dev
SEED_ADMIN_PASSWORD=change-me-before-prod
