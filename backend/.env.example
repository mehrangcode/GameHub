# Copy to .env for local development.  Every variable here is Zod-validated at
# startup by src/config/env.ts — a missing or malformed value exits the process.

NODE_ENV=development
PORT=3000
ADMIN_PORT=3100

# 02-technical-prd.md §6.1 — sqlite in dev, postgresql in prod.
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"

# ★ Optional, and not a compromise when unset (S27, 02 §3.2). No REDIS_URL means
# the in-memory Socket.IO adapter and the in-process rate limiter — which is the
# correct configuration for the single-process VPS M0 targets. Redis earns its
# place when there is a *second* API instance, because that is the point at
# which `io.to(room).emit(...)` has to cross a process boundary.
#
#   docker compose up -d redis        (from the repository root)
#
# What may live in it: the socket adapter, rate-limit windows, presence.
# What may NEVER: wallet or ledger state, matchmaking cooldowns, game state,
# reward idempotency keys. Enforced by tests/unit/redis-keys.test.ts, not by
# remembering.
# REDIS_URL=redis://localhost:6379

CORS_ORIGIN=http://localhost:5173

# Minimum 32 characters each. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-0123456789
GUEST_TOKEN_SECRET=dev-only-guest-secret-change-me-0123456789

# 07-security-and-anticheat.md §5.3 — 10 min access, 30 day refresh, 12 h guest.
# The access token is stateless and cannot be revoked, so its TTL is the window
# in which a ban or a logout has not taken effect yet. Keep it short.
ACCESS_TOKEN_TTL_SEC=600
REFRESH_TOKEN_TTL_SEC=2592000
GUEST_SESSION_TTL_SEC=43200

# argon2id cost — OWASP's baseline (07 §5.3). Raising these is the response to
# faster attacker hardware; existing hashes upgrade on the owner's next login.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Global per-IP sliding window, then the login-specific throttle.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SEC=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SEC=900

# Invites (S19). A day covers "we're playing tonight" without leaving a live
# join capability in a chat log for a month; a host may ask for up to 30 days
# per link. The resolve budget is separate from the global one because
# `GET /invites/:code` is the only public endpoint taking a guessable secret
# (07 §5.2) — generous enough that a pre-join screen reloading is never
# throttled.
INVITE_TTL_HOURS=24
INVITE_RESOLVE_MAX=30
INVITE_RESOLVE_WINDOW_SEC=60

LOG_LEVEL=debug

SEED_ADMIN_EMAIL=admin@local.dev
SEED_ADMIN_PASSWORD=change-me-before-prod

# ─── The admin console — 12-admin-console.md §2.5 (S48) ──────────────────────
#
# The admin API is a SECOND PROCESS on a SECOND PORT, from the same image and
# the same container.ts:  npm run dev:admin
#
# :3100 is never published. Caddy reaches it over the internal Docker network
# and nothing else does — `docker compose config` must show no `ports:` entry
# for the admin-api service.
ADMIN_PORT=3100
# 0.0.0.0 inside Docker, where the network is the boundary. 127.0.0.1 bare-metal.
ADMIN_BIND=127.0.0.1
# The only CORS origin the admin app accepts. admin-frontend/'s Vite dev server.
ADMIN_ORIGIN=http://localhost:5273

# ★ REQUIRED, and the admin process refuses to boot without it.
#
#     openssl rand -base64 32
#
# AES-256-GCM key for TOTP secrets at rest, so a database dump alone is not a
# working second factor. It is NOT generated when absent, deliberately: a
# generated key would be a different key on the next restart, silently
# invalidating every enrolled authenticator — a failure that presents as "my
# phone stopped working" and is diagnosed by nobody.
#
# Keep it out of the public API's environment. `main.ts` parses the ordinary
# EnvSchema, where this is optional, so the internet-facing process never holds
# the key that unlocks every admin's second factor.
ADMIN_TOTP_ENC_KEY=

# 12 §3.2 — 15 min access, 8 h absolute, 30 min idle. Three clocks, three
# different questions: how long may one login last, is this an abandoned tab,
# and (below) was the human here *recently*.
ADMIN_ACCESS_TTL_SEC=900
ADMIN_SESSION_IDLE_MIN=30
ADMIN_SESSION_ABSOLUTE_HOURS=8

# 12 §3.4 — how long a fresh TOTP authorises a destructive (⚡) action. Five
# minutes and six digits is the entire cost of making a stolen laptop session
# unable to mint coins or ban somebody.
ADMIN_STEPUP_WINDOW_MIN=5

# The password step hands out a challenge; the code step spends it.
ADMIN_CHALLENGE_TTL_SEC=120
# 5 failed codes → locked for 15 minutes, plus an ALERT SecurityEvent.
ADMIN_MFA_MAX_ATTEMPTS=5
ADMIN_LOCKOUT_MIN=15

# Optional CIDR/address allowlist, comma-separated. EMPTY DISABLES IT, and that
# is the right default: an operator on a domestic connection with a rotating
# address who pins an allowlist locks themselves out at 3am. It earns its place
# when the console is reached from a fixed office address or a VPN.
ADMIN_IP_ALLOWLIST=

# 12 §6.3 — how the api process hears about a new ControlCommand. `poll` is a
# supported configuration, not a degraded one: the database row is the
# authority either way, and Redis only makes it feel instant.
CONTROL_TRANSPORT=poll
